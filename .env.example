# Environment variables for LLM Faceoff

# Required API Keys
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here

# Optional Configuration
DEFAULT_DEBATE_FORMAT=oxford
DEFAULT_MAX_TURNS=10
DEFAULT_MAX_RESPONSE_LENGTH=1000
DEFAULT_TEMPERATURE=0.7

# Logging
LOG_LEVEL=INFO
# LOG_FILE=debate.log

# Output Settings
OUTPUT_DIRECTORY=./outputs
SAVE_TRANSCRIPTS=true
TRANSCRIPT_FORMAT=markdown  # Options: markdown, json, html, all

# Rate Limiting
RATE_LIMIT_RPM=60
REQUEST_TIMEOUT=30
MAX_RETRIES=3